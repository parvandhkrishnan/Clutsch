# =============================================================================
# Clutsch Backend - Required Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.

# --- Security Keys (REQUIRED - app will crash at startup if missing) ---
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=your-jwt-secret-key-here-min-32-chars

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-encryption-key-here

# --- Seed User Passwords (REQUIRED - app will crash at startup if missing) ---
# Use strong passwords in production (min 12 chars, mixed case + numbers)
ADMIN_PASSWORD=admin-secure-password
JOHN_PASSWORD=john-secure-password
SARAH_PASSWORD=sarah-secure-password

# --- Integration Keys ---
# Optional for development, required for production.
# Without this set, AI scoring silently falls back to a basic keyword-matching
# stub (MockAIProvider) instead of real Gemini analysis — see ai_analyzer.py.
GEMINI_API_KEY=your-gemini-api-key-here

# --- Razorpay Payment Keys ---
# Required for production billing
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
RAZORPAY_PLAN_PRO=plan_pro_monthly_id
RAZORPAY_PLAN_SME=plan_sme_monthly_id
RAZORPAY_PLAN_ENTERPRISE=plan_enterprise_id

# --- Configuration ---
# Set to "true" to enforce HTTPS redirect (recommended in production)
ENFORCE_HTTPS=false

# Comma-separated list of allowed CORS origins
# In production, set to your actual domain (e.g., https://app.clutsch.com)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Brute-force protection settings
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
